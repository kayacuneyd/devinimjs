#--------------------------------------------------------------------
# DevinimJS ci4-cms — Example Environment
#--------------------------------------------------------------------
# Copy to `.env` at the project root and adjust. Only the keys a shared-
# hosting CI4+SQLite install actually needs are included; everything
# else keeps appstarter defaults.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# 'development' locally, 'production' on the server (also flips off
# DBDebug and enables the WAL pragmas in app/Config/Boot/production.php).

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# MUST match the public URL, including the sub-directory when the site
# does not live at the vhost root (shared hosting!).

app.baseURL = 'http://localhost:8080/'
# app.baseURL = 'https://example.com/'

#--------------------------------------------------------------------
# DATABASE (roadmap 2.7 / ADR-003)
#--------------------------------------------------------------------
# The shipped app/Config/Database.php already defaults to:
#   database = WRITEPATH . 'database.sqlite'  (writable/database.sqlite)
#   DBDriver = SQLite3
# so on a stock install NOTHING below needs to be set. Override here
# only to move the file or to switch drivers (MySQL etc.).

# database.default.database = '/absolute/path/to/writable/database.sqlite'
# database.default.DBDriver = 'SQLite3'
# database.default.DBDebug  = true

#--------------------------------------------------------------------
# SECURITY / CSRF (roadmap 2.10)
#--------------------------------------------------------------------
# These names matter to the kit:
#   - security.headerName is the header the DevinimJS createApi() client
#     sends on state-changing requests (must stay 'X-CSRF-TOKEN' unless
#     you change the JS too);
#   - security.tokenName is only used by classic form posts (csrf_field());
#   - the session-bound hash itself is rendered into <meta name="csrf-token">
#     by the login and admin-shell views and verified server-side against
#     csrf_hash().

# security.tokenName  = 'csrf_token_name'
# security.headerName = 'X-CSRF-TOKEN'
# security.cookieName = 'csrf_cookie_name'
# security.expires    = 7200
# security.regenerate = true
# security.samesite   = 'Lax'

#--------------------------------------------------------------------
# SESSION (roadmap 2.2 / ADR-004 — custom session auth)
#--------------------------------------------------------------------
# File-driver sessions in writable/session work everywhere. Keep the
# cookie name unique per site on shared hosting.

# session.driver            = 'CodeIgniter\Session\Handlers\FileHandler'
# session.cookieName        = 'ci4cms_session'
# session.expiration        = 7200
# session.savePath          = null
# session.matchIP           = false
# session.timeToUpdate      = 300
# session.regenerateDestroy = false
